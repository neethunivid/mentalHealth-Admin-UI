/* パニック障害チェック */function  event1(){ a =0; for (  i =0; i<=26 ; i++)  if (document.selfcheck.elements[i].checked) { a += eval(document.selfcheck.elements[i].value); }    if ( a <= 3 ) {    document.getElementById("result").innerHTML="<div class='box8'><span class='m_font_b'>該当する項目は全部で"+a+"個でパニック障害はあてはまりません。</span></div>" ;   }      if ( a >= 4 ) {    document.getElementById("result").innerHTML="<div class='box8'><span class='m_font_b'>該当する項目は全部で"+a+"個（4個以上）でパニック障害があてはまります。</span></div>" ;    } }/* フォーム表示 */function ondsp1(num){  if (num == 0)  {    document.getElementById("").style.display="none";  }  else  {    document.getElementById("selfcheckform").style.display="block";  }}